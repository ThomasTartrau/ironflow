  "query": "\n                SELECT sd.step_id, sd.depends_on, sd.created_at\n                FROM ironflow.step_dependencies sd\n                JOIN ironflow.steps s ON s.id = sd.step_id\n                WHERE s.run_id = $1\n                ORDER BY sd.created_at ASC\n                ",
