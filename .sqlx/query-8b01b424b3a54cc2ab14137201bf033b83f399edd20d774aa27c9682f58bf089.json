  "query": "\n                    SELECT id, key, encrypted_value, nonce, key_version\n                    FROM ironflow.secrets\n                    WHERE key_version <> $1\n                      AND ($2::uuid IS NULL OR id > $2)\n                    ORDER BY id ASC\n                    LIMIT $3\n                    ",
