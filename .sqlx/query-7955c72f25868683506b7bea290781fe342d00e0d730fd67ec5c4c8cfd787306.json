  "db_name": "PostgreSQL",
  "query": "\n                SELECT id, key, created_at, updated_at, COUNT(*) OVER() as \"total_count!: i64\"\n                FROM ironflow.secrets\n                WHERE key LIKE $1 ESCAPE '\\'\n                ORDER BY key ASC\n                LIMIT $2 OFFSET $3\n                ",
