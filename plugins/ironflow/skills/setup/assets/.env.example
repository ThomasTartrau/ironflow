# Copy to `.env`. Both binaries read it through dotenvy.

# ---- API server -----------------------------------------------------------
# `development` or `production` (DATABASE_URL becomes mandatory). Unset, the
# server behaves as in production for its secrets.
IRONFLOW_ENV=development
PORT=3000
# Session cookies are always `Secure` (browsers accept them on http://localhost).
# Set to 1 only for plain-HTTP dev on a non-localhost origin. Ignored in production,
# where plain-HTTP requests (X-Forwarded-Proto: http) are redirected with a 308.
# IRONFLOW_INSECURE_COOKIES=1
# Shared secret between the API server and its workers. Mandatory, >= 32 bytes,
# must not start with `ironflow-dev-`: the server refuses to boot otherwise.
# Only with IRONFLOW_ENV=development may it be left unset: the server then
# generates one per process and logs it, but the worker cannot read it from
# here. scaffold.sh fills it in .env; otherwise generate one with:
# openssl rand -hex 32
# WORKER_TOKEN=
# JWT signing secret for dashboard sessions. Same rules as WORKER_TOKEN above
# (a generated one is not logged; sessions end when the server stops).
# JWT_SECRET=
# Postgres connection string. Required in production, ignored by the in-memory store.
# DATABASE_URL=postgres://ironflow:ironflow@localhost:5432/ironflow
# Comma-separated list of extra CORS origins. Unset = same-origin only.
# ALLOWED_ORIGINS=http://localhost:5173
# Reverse proxies (IPs or CIDR ranges) whose X-Forwarded-For the rate limiters
# believe. Unset = the TCP peer is the client. Behind a proxy, list it here or
# every client shares the proxy's rate-limit bucket.
# TRUSTED_PROXIES=10.0.0.0/8
# Versioned AES-GCM keys for the encrypted secret store, `version:hex64` pairs.
# Generate one with: openssl rand -hex 32
# IRONFLOW_SECRET_KEYS=1:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Directory for step artifacts. Unset = artifacts disabled (routes answer 501).
# ARTIFACTS_DIR=./artifacts
# Outbound webhook called on run status changes and step failures.
# WEBHOOK_URL=https://hooks.example.com/ironflow
# Per-run cost cap in USD when neither the request nor the handler sets one.
# IRONFLOW_DEFAULT_RUN_MAX_COST_USD=1.00
# Global monthly cost quota in USD. Run creation answers 429 beyond it.
# IRONFLOW_MONTHLY_COST_LIMIT_USD=100.00

# ---- Worker ---------------------------------------------------------------
API_URL=http://localhost:3000
# Number of runs a single worker executes concurrently.
CONCURRENCY=2
POLL_INTERVAL_SECS=2

# ---- Agent provider (worker) ---------------------------------------------
# ClaudeCodeProvider needs the `claude` CLI on PATH and a logged-in account.
# HTTP providers read their key from the environment instead:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ---- Logging --------------------------------------------------------------
RUST_LOG=info,ironflow=debug
