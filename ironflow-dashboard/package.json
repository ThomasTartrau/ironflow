{
	"name": "ironflow-dashboard",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"format": "biome format --write .",
		"check": "biome check .",
		"lint": "biome check .",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"generate:types": "openapi-typescript ./openapi.json --output src/app/lib/types.generated.ts && pnpm format"
	},
	"dependencies": {
		"@base-ui/react": "^1.3.0",
		"@fontsource-variable/inter": "^5.2.8",
		"@reduxjs/toolkit": "^2.11.2",
		"@tailwindcss/vite": "^4.2.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"framer-motion": "^12.38.0",
		"lucide-react": "^1.7.0",
		"nuqs": "^2.8.9",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-markdown": "^10.1.0",
		"react-redux": "^9.2.0",
		"react-router": "^7.13.2",
		"shadcn": "^4.1.0",
		"shiki": "^4.0.2",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/json-schema": "^7.0.15",
		"@types/node": "^24.12.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"happy-dom": "^20.8.9",
		"openapi-typescript": "^7.8.0",
		"typescript": "~5.9.3",
		"vite": "^8.0.1",
		"vitest": "^4.1.2"
	},
	"packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
